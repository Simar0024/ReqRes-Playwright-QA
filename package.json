  "bugs": {
    "url": "https://github.com/Simar0024/ReqRes-Playwright-QA/issues"
  },
  "homepage": "https://github.com/Simar0024/ReqRes-Playwright-QA#readme",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "allure-commandline": "^2.42.0",
    "allure-playwright": "^3.9.0"
  }
}